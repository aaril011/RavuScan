<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ravu_bg"
    tools:context=".ui.tentang.TentangFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="112dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:includeFontPadding="false"
                    android:text="Tentang RavuScan"
                    android:textColor="@color/ravu_navy"
                    android:textSize="30sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/poppins_regular"
                    android:includeFontPadding="false"
                    android:text="Kenali aplikasi ini lebih dekat."
                    android:textColor="@color/ravu_navy"
                    android:textSize="14sp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="18dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="2dp"
                    app:cardUseCompatPadding="true"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="20dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/logo_1"
                        android:contentDescription="Logo RavuScan" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/poppins_bold"
                    android:includeFontPadding="false"
                    android:text="Terkait"
                    android:textColor="@color/ravu_navy"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/poppins_regular"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:text="RavuScan membantu mengenali jenis tanaman hanya dari foto daunnya. Cukup arahkan kamera ke daun, aplikasi akan menebak jenis tanamannya dan memberi tahu seberapa yakin tebakan itu."
                    android:textColor="@color/ravu_grey"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:includeFontPadding="false"
                    android:text="Asal nama Ravu"
                    android:textColor="@color/ravu_navy"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/poppins_regular"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:text="Ravu berasal dari bahasa Kaili yang dipakai masyarakat Sulawesi Tengah. Artinya: daun — sesuai cara kerja aplikasi yang mengenali tanaman dari daunnya."
                    android:textColor="@color/ravu_grey"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:includeFontPadding="false"
                    android:text="Arti singkatan RAVU"
                    android:textColor="@color/ravu_navy"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/poppins_regular"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:text="RAVU adalah kepanjangan dari ResNet Analysis with Vision Enhancement using Unique CLAHE Scan, yaitu gabungan teknologi di balik aplikasi ini:"
                    android:textColor="@color/ravu_grey"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/poppins_regular"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:text="• ResNet: teknologi AI pengenal gambar yang mengenali 20 jenis tanaman.\n• CLAHE: penajam detail foto agar urat dan tekstur daun terlihat jelas.\n• Scan: pemindaian daun yang berjalan langsung di HP."
                    android:textColor="@color/ravu_grey"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:includeFontPadding="false"
                    android:text="Privasi data"
                    android:textColor="@color/ravu_navy"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/poppins_regular"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:text="Tidak perlu internet. Foto dan hasil tersimpan hanya di HP-mu."
                    android:textColor="@color/ravu_grey"
                    android:textSize="14sp" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="28dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKembali"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:fontFamily="@font/poppins_medium"
                android:text="Kembali"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:backgroundTint="@color/ravu_green"
                app:cornerRadius="16dp"
                app:elevation="0dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="© 2026 RavuScan"
                android:textColor="@color/ravu_grey"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="Seluruh hak cipta dilindungi"
                android:textColor="@color/ravu_grey"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Lapisan appbar seperti beranda -->
    <View
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_top_cover"
        android:clickable="false"
        android:focusable="false" />
</FrameLayout>
